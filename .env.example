# Model Provider API Keys (at least one text provider required)
NVIDIA_API_KEY=nvapi-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...
# Alternatively, GOOGLE_API_KEY is also accepted
GOOGLE_API_KEY=...

# NVIDIA Multimodal / Vision Model (Optional - defaults to meta/llama-3.2-11b-vision-instruct)
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Web Search Provider (Optional - enables live internet search)
TAVILY_API_KEY=tvly-...

# GitHub Integration (Optional - enables higher rate limits & authenticated GitHub operations)
GITHUB_TOKEN=ghp_...

# Voice Text-to-Speech (Optional - Cloudflare Workers AI for Aura-1 TTS)
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_TTS_MODEL=@cf/deepgram/aura-1

# Voice Speech-to-Text Model (Optional - defaults to whisper-large-v3-turbo via Groq)
GROQ_STT_MODEL=whisper-large-v3-turbo

# Persistence & Storage
MAMBA_DB_PATH=.mamba/memory.db

